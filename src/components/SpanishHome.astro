---
import SearchPanel from './SearchPanel.astro';
import ConservationGuide from './ConservationGuide.astro';
import { pages } from '../content/site';

const featured = pages.find((page) => page.path === 'que-hacemos');
const species = pages.find((page) => page.path === 'los-primates-2');
const speciesImages = ['https://images.unsplash.com/photo-1764214730289-34277aa453a2?auto=format&fit=crop&w=1800&q=85', 'https://images.unsplash.com/photo-1724257543281-d2bcc65d9c06?auto=format&fit=crop&w=1800&q=85', 'https://images.unsplash.com/photo-1668364491545-1d336b038186?auto=format&fit=crop&w=1800&q=85'];
const pillars = [
  { number: '01', title: 'Rescate y recuperación', text: 'Un entorno de cuidado pensado alrededor de las necesidades de cada primate.', href: '/es/que-hacemos/rescate-y-rehabilitacion', image: 'https://images.unsplash.com/photo-1535338454770-8be927b5a00b?auto=format&fit=crop&w=1800&q=85', alt: 'Entorno natural relacionado con el rescate y la conservación' },
  { number: '02', title: 'Educación y conocimiento', text: 'Compartir conocimiento ayuda a construir una relación más respetuosa con los animales.', href: '/es/que-hacemos/formacion-y-educacion', image: 'https://images.unsplash.com/photo-1470252649378-9c29740c9fa8?auto=format&fit=crop&w=1800&q=85', alt: 'Imagen relacionada con educación ambiental' },
  { number: '03', title: 'Una mirada responsable', text: 'Conocer las diferencias entre especies es el primer paso para comprender sus necesidades.', href: '/es/los-primates-2', image: 'https://images.unsplash.com/photo-1497436072909-60f36e1d4b1b?auto=format&fit=crop&w=1800&q=85', alt: 'Paisaje natural que conecta con la conservación de primates' },
];
---
<div class="home-shell home-redesign">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="hero-copy">
      <p class="kicker"><span class="kicker-dot"></span> Centro de rescate y recuperación</p>
      <h1 id="home-title">Cuidar la vida.<br /><em>Cambiar la mirada.</em></h1>
      <p class="lede">Un lugar donde el rescate de primates se encuentra con el cuidado diario, el conocimiento y la educación.</p>
      <div class="hero-actions">
        <a class="button button-light" href="/es/que-hacemos">Conoce nuestra misión <span aria-hidden="true">↗</span></a>
        <a class="quiet-link" href="/es/que-puedes-hacer-tu">Formas de ayudar <span aria-hidden="true">↗</span></a>
      </div>
      <div class="hero-note"><span class="hero-note-mark" aria-hidden="true">✳</span><span>Respeto por cada individuo.<br />Compromiso con el bienestar.</span></div>
    </div>
    <div class="hero-media">
      <img src="https://images.unsplash.com/photo-1652451160831-7311e014cd63?auto=format&fit=crop&w=1800&q=85" alt="Primate en un entorno de cuidado" width="1050" height="1400" fetchpriority="high" />
      <span class="image-caption">Rainfer <span aria-hidden="true">/</span> rescate · cuidado · aprendizaje</span>
      <span class="hero-image-index" aria-hidden="true">01 — 03</span>
    </div>
  </section>
  <div class="home-trust-strip" aria-label="Áreas de trabajo"><span>Una misión compartida</span><span>Bienestar animal</span><span>Educación ambiental</span><span>Conocimiento responsable</span></div>
  <section class="intro-band home-intro">
    <div><p class="kicker">La razón de estar aquí</p><h2>El cuidado empieza por <em>comprender.</em></h2></div>
    <p>El bienestar no es un gesto aislado. Se construye con atención, entornos seguros, conocimiento y una comunidad dispuesta a aprender. Cada historia merece una mirada informada y respetuosa.</p>
  </section>
  <section class="home-pillars" aria-labelledby="pillars-title">
    <div class="section-heading home-section-heading"><p class="kicker">Lo que nos mueve</p><h2 id="pillars-title">Del cuidado a la conciencia.</h2><p>Explora las áreas que conectan la protección de los primates con una sociedad mejor informada.</p></div>
    <div class="pillar-grid">
      {pillars.map((pillar) => <a class="pillar-card" href={pillar.href}><div class="pillar-image"><img src={pillar.image} alt={pillar.alt} loading="lazy" width="800" height="600" /><span class="pillar-number">{pillar.number}</span></div><div class="pillar-content"><h3>{pillar.title}</h3><p>{pillar.text}</p><span class="pillar-link">Explorar <span aria-hidden="true">↗</span></span></div></a>)}
    </div>
  </section>
  <ConservationGuide locale="es" />
  {featured && <section class="feature-section home-feature"><div class="feature-image"><img src="https://images.unsplash.com/photo-1473448912268-2022ce9509d8?auto=format&fit=crop&w=1800&q=85" alt="Paisaje natural que inspira la conservación" loading="lazy" width="1800" height="1200" /></div><div class="feature-copy"><p class="kicker">Nuestra labor</p><h2>Una labor que va más allá del rescate.</h2><p>{featured.summary} El cuidado, la divulgación y la educación forman parte de una misma conversación sobre bienestar.</p><a class="text-link" href="/es/que-hacemos">Conocer el trabajo <span aria-hidden="true">↗</span></a></div></section>}
  {species && <section class="species-section home-species"><div class="section-heading"><p class="kicker">Conocer para cuidar</p><h2>El mundo de los primates.</h2><p>Descubre algunas de las familias de primates y acércate a sus características desde el respeto.</p></div><div class="species-grid">{species.cards?.slice(0, 3).map((card, index) => <a href={card.href} class="species-card"><img src={speciesImages[index]} alt={card.title} loading="lazy" width="800" height="600" /><span>{card.title}<span class="species-arrow" aria-hidden="true">↗</span></span></a>)}</div><a class="text-link species-all-link" href="/es/los-primates-2">Explorar la guía de primates <span aria-hidden="true">↗</span></a></section>}
  <section class="home-visit-band"><div class="visit-symbol" aria-hidden="true">✳</div><div><p class="kicker">Formar parte del cambio</p><h2>El cuidado también se construye en comunidad.</h2><p>Infórmate sobre las formas de apoyar la misión y consulta siempre los canales oficiales para conocer las opciones disponibles.</p></div><a class="button button-light" href="/es/que-puedes-hacer-tu">Cómo puedes ayudar <span aria-hidden="true">↗</span></a></section>
  <section class="home-explore"><div><p class="kicker">¿Buscas algo concreto?</p><h2>Continúa explorando.</h2><p>Encuentra información sobre el centro, sus programas y sus recursos.</p></div><SearchPanel locale="es" /></section>
</div>
