---
import type { Locale } from '../content/site';
import { allPages, localizedPath, navItems } from '../content/site';
import { ui } from '../i18n/strings';
const { locale = 'es' } = Astro.props as { locale: Locale };
const copy = ui[locale];
const other: Locale = locale === 'es' ? 'en' : 'es';
const current = Astro.url.pathname.replace(/^\/(es|en)\/?/, '').replace(/\/$/, '');
const currentPage = allPages.find((page) => locale === 'es' ? page.path === current : page.enPath === current);
const langPath = currentPage && (other === 'es' || currentPage.enPath) ? localizedPath(currentPage, other) : `/${other}`;
---
<header class="site-header">
  <div class="notice"><span>RAINFER</span><span>{locale === 'es' ? 'Rescate · bienestar · educación' : 'Rescue · welfare · education'}</span></div>
  <div class="nav-wrap">
    <a class="wordmark" href={locale === 'es' ? '/' : '/en'} aria-label={locale === 'es' ? 'Rainfer — inicio' : 'Rainfer — home'}>Rainfer<span class="wordmark-mark" aria-hidden="true">/</span></a>
    <button class="menu-button" type="button" data-menu-button data-open-label={copy.menu} data-close-label={copy.close} aria-expanded="false" aria-controls="site-menu">{copy.menu}</button>
    <nav id="site-menu" class="site-nav" data-menu aria-label={locale === 'es' ? 'Navegación principal' : 'Main navigation'}>
      {navItems.map((item) => {
        const href = locale === 'es' ? item.href : item.enHref;
        const active = Astro.url.pathname === href || Astro.url.pathname.startsWith(`${href}/`);
        return <a href={href} class={active ? 'active' : undefined} aria-current={active ? 'page' : undefined}>{item[locale]}</a>;
      })}
      <a class="language-link" href={langPath} lang={other} aria-label={locale === 'es' ? 'View this page in English' : 'Ver esta página en español'}>{other.toUpperCase()}</a>
    </nav>
  </div>
</header>
