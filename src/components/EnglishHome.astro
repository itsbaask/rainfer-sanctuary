---
import SearchPanel from './SearchPanel.astro';
import ConservationGuide from './ConservationGuide.astro';
import { pages } from '../content/site';
const featured = pages.find((page) => page.path === 'que-hacemos');
const species = pages.find((page) => page.path === 'los-primates-2');
const speciesImages = ['https://images.unsplash.com/photo-1654630122082-68aeda5c27ea?auto=format&fit=crop&w=1800&q=85', 'https://images.unsplash.com/photo-1762301394051-1d17104067b2?auto=format&fit=crop&w=1800&q=85', 'https://images.unsplash.com/photo-1770211162887-af11667f240f?auto=format&fit=crop&w=1800&q=85'];
const pillars = [
  { number: '01', title: 'Rescue and recovery', text: 'A care environment shaped around the needs of each primate.', href: '/en/what-we-do/rescue-and-rehabilitation', image: 'https://images.unsplash.com/photo-1513836279014-a89f7a76ae86?auto=format&fit=crop&w=1800&q=85', alt: 'Chimpanzee in a care environment' },
  { number: '02', title: 'Education and knowledge', text: 'Sharing knowledge can build a more respectful relationship with animals.', href: '/en/what-we-do/training-and-education', image: 'https://images.unsplash.com/photo-1482938289607-e9573fc25ebb?auto=format&fit=crop&w=1800&q=85', alt: 'Environmental education' },
  { number: '03', title: 'A more informed view', text: 'Understanding species is a first step towards understanding their needs.', href: '/en/primates', image: 'https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=1800&q=85', alt: 'Gibbon in its environment' },
];
---
<div class="home-shell home-redesign">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="hero-copy">
      <p class="kicker"><span class="kicker-dot"></span> Primate rescue and recovery</p>
      <h1 id="home-title">Care for life.<br /><em>Change perspective.</em></h1>
      <p class="lede">A place where primate rescue meets daily care, knowledge and education.</p>
      <div class="hero-actions">
        <a class="button button-light" href="/en/what-we-do">Discover our mission <span aria-hidden="true">↗</span></a>
        <a class="quiet-link" href="/en/support-us">Ways to help <span aria-hidden="true">↗</span></a>
      </div>
      <div class="hero-note"><span class="hero-note-mark" aria-hidden="true">✳</span><span>Respect for every individual.<br />A commitment to welfare.</span></div>
    </div>
    <div class="hero-media">
      <img src="https://images.unsplash.com/photo-1655981652077-f5303843b81b?auto=format&fit=crop&w=1800&q=85" alt="Primate in a care environment" width="1050" height="1400" fetchpriority="high" />
      <span class="image-caption">Rainfer <span aria-hidden="true">/</span> rescue · care · learning</span>
      <span class="hero-image-index" aria-hidden="true">01 — 03</span>
    </div>
  </section>
  <div class="home-trust-strip" aria-label="Areas of work"><span>A shared mission</span><span>Animal welfare</span><span>Environmental education</span><span>Responsible knowledge</span></div>
  <section class="intro-band home-intro"><div><p class="kicker">Why this work matters</p><h2>Care begins with <em>understanding.</em></h2></div><p>Welfare is not a single gesture. It is built through attention, safe environments, knowledge and a community willing to learn. Every story deserves an informed and respectful view.</p></section>
  <section class="home-pillars" aria-labelledby="pillars-title"><div class="section-heading home-section-heading"><p class="kicker">What moves us</p><h2>From care to awareness.</h2><p>Explore the work connecting primate protection with a better-informed society.</p></div><div class="pillar-grid">{pillars.map((pillar) => <a class="pillar-card" href={pillar.href}><div class="pillar-image"><img src={pillar.image} alt={pillar.alt} loading="lazy" width="800" height="600" /><span class="pillar-number">{pillar.number}</span></div><div class="pillar-content"><h3>{pillar.title}</h3><p>{pillar.text}</p><span class="pillar-link">Explore <span aria-hidden="true">↗</span></span></div></a>)}</div></section>
  <ConservationGuide locale="en" />
  {featured && <section class="feature-section home-feature"><div class="feature-image"><img src="https://images.unsplash.com/photo-1518837695005-2083093ee35b?auto=format&fit=crop&w=1800&q=85" alt="Natural space at a primate care centre" loading="lazy" width="1800" height="1200" /></div><div class="feature-copy"><p class="kicker">Our work</p><h2>Care that goes beyond rescue.</h2><p>{featured.enSummary} Care, outreach and education are part of the same conversation about welfare.</p><a class="text-link" href="/en/what-we-do">Explore our work <span aria-hidden="true">↗</span></a></div></section>}
  {species && <section class="species-section home-species"><div class="section-heading"><p class="kicker">Know to care</p><h2>The world of primates.</h2><p>Discover primate families and learn about their characteristics with respect.</p></div><div class="species-grid">{species.cards?.slice(0,3).map((card, index) => <a href={['/en/primates/chimpanzees','/en/primates/orangutans','/en/primates/gibbons'][index]} class="species-card"><img src={speciesImages[index]} alt={card.enTitle} loading="lazy" width="800" height="600" /><span>{card.enTitle}<span class="species-arrow" aria-hidden="true">↗</span></span></a>)}</div><a class="text-link species-all-link" href="/en/primates">Explore the primate guide <span aria-hidden="true">↗</span></a></section>}
  <section class="home-visit-band"><div class="visit-symbol" aria-hidden="true">✳</div><div><p class="kicker">Be part of the change</p><h2>Care is built by a community.</h2><p>Learn how to support the mission and use official channels to confirm the options currently available.</p></div><a class="button button-light" href="/en/support-us">How you can help <span aria-hidden="true">↗</span></a></section>
  <section class="home-explore"><div><p class="kicker">Looking for something specific?</p><h2>Keep exploring.</h2><p>Find information about the centre, its programmes and resources.</p></div><SearchPanel locale="en" /></section>
</div>
