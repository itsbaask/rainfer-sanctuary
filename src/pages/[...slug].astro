---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageContent from '../components/PageContent.astro';
import EnglishHome from '../components/EnglishHome.astro';
import SpanishHome from '../components/SpanishHome.astro';
import { allPages, type Locale } from '../content/site';

export function getStaticPaths() {
  const paths = [{ params: { slug: 'es' }, props: { locale: 'es' as Locale, page: allPages[0] } }, { params: { slug: 'en' }, props: { locale: 'en' as Locale, page: allPages[0] } }];
  const spanishPaths = new Set(allPages.map((page) => page.path.replace(/^\/+|\/+$/g, '')));
  const aliases = new Set<string>();
  for (const page of allPages) {
    paths.push({ params: { slug: 'es/' + page.path }, props: { locale: 'es' as Locale, page } });
    if (page.enPath) paths.push({ params: { slug: 'en/' + page.enPath }, props: { locale: 'en' as Locale, page } });

    // Recreate clean legacy URLs from archived source-file paths when they do not
    // collide with a current canonical page. Ignore WordPress/feed endpoints.
    if (page.sourceFile) {
      const alias = page.sourceFile
        .replace(/\/index\.html$/i, '')
        .replace(/\.html$/i, '')
        .replace(/^\/+|\/+$/g, '');
      const isNonPageEndpoint = /(^|\/)(wp-content|wp-admin|wp-json|author|comments|feed)(\/|$)/i.test(alias) || /(^|\/)feed$/i.test(alias);
      if (alias && !/[?#]/.test(alias) && alias !== 'index.html' && !isNonPageEndpoint && !spanishPaths.has(alias) && !aliases.has(alias)) {
        aliases.add(alias);
        paths.push({ params: { slug: 'es/' + alias }, props: { locale: 'es' as Locale, page } });
      }
    }
  }
  return paths;
}
const { locale, page } = Astro.props as { locale: Locale; page: typeof allPages[number] };
const title = locale === 'es' ? page.title : page.enTitle;
const description = locale === 'es' ? page.summary : page.enSummary;
const path = Astro.url.pathname;
const isEnglishHome = Astro.params.slug === 'en';
const isSpanishHome = Astro.params.slug === 'es';
---
{isEnglishHome ? (
  <BaseLayout locale="en" title="Rainfer — Rescue, welfare and education" description="Explore primate care, environmental education and responsible ways to support the work." path="/en/" image="https://images.unsplash.com/photo-1655981652077-f5303843b81b?auto=format&fit=crop&w=1800&q=85">
    <EnglishHome />
  </BaseLayout>
) : isSpanishHome ? (
  <BaseLayout locale="es" title="Rainfer — Rescate, bienestar y educación" description="Conoce Rainfer, su trabajo con primates, la educación ambiental y las formas de apoyar una cultura de cuidado." path="/es/" image="https://images.unsplash.com/photo-1652451160831-7311e014cd63?auto=format&fit=crop&w=1800&q=85">
    <SpanishHome />
  </BaseLayout>
) : (
  <BaseLayout locale={locale} title={`${title} — Rainfer`} description={description} image={page.image} path={path}>
    <PageContent page={page} locale={locale} />
  </BaseLayout>
)}
