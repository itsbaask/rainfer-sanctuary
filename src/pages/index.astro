---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchPanel from '../components/SearchPanel.astro';
import ConservationGuide from '../components/ConservationGuide.astro';
import { pages } from '../content/site';

const featured = pages.find((page) => page.path === 'que-hacemos');
const species = pages.find((page) => page.path === 'los-primates-2');
const speciesImages = ['https://images.unsplash.com/photo-1775648429728-608fb2dad2e3?auto=format&fit=crop&w=1800&q=85', 'https://images.unsplash.com/photo-1757840991129-42e893566a9c?auto=format&fit=crop&w=1800&q=85', 'https://images.unsplash.com/photo-1778659852933-374924d835ce?auto=format&fit=crop&w=1800&q=85'];
const pillars = [
  { number: '01', title: 'Rescate y recuperación', text: 'Un entorno de cuidado pensado alrededor de las necesidades de cada primate.', href: '/es/que-hacemos/rescate-y-rehabilitacion', image: 'https://images.unsplash.com/photo-1522071820081-009f0129c71c?auto=format&fit=crop&w=1800&q=85', alt: 'Personas colaborando para apoyar la conservación' },
  { number: '02', title: 'Educación y conocimiento', text: 'Compartir conocimiento ayuda a construir una relación más respetuosa con los animales.', href: '/es/que-hacemos/formacion-y-educacion', image: 'https://images.unsplash.com/photo-1509062522246-3755977927d7?auto=format&fit=crop&w=1800&q=85', alt: 'Personas aprendiendo en un entorno educativo' },
  { number: '03', title: 'Una mirada responsable', text: 'Conocer las diferencias entre especies es el primer paso para comprender sus necesidades.', href: '/es/los-primates-2', image: 'https://images.unsplash.com/photo-1523580494863-6f3031224c94?auto=format&fit=crop&w=1800&q=85', alt: 'Espacio de aprendizaje relacionado con la conservación' },
];
---
<BaseLayout title="Rainfer — Rescate, bienestar y educación" description="Conoce Rainfer, su trabajo con primates, la educación ambiental y las formas de apoyar una cultura de cuidado." path="/" image="https://images.unsplash.com/photo-1670597898656-d159165d080d?auto=format&fit=crop&w=1800&q=85">
  <div class="home-shell home-redesign">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="hero-copy">
        <p class="kicker"><span class="kicker-dot"></span> Centro de rescate y recuperación</p>
        <h1 id="home-title">Cuidar la vida.<br /><em>Cambiar la mirada.</em></h1>
        <p class="lede">Un lugar donde el rescate de primates se encuentra con el cuidado diario, el conocimiento y la educación.</p>
        <div class="hero-actions">
          <a class="button button-light" href="/es/que-hacemos">Conoce nuestra misión <span aria-hidden="true">↗</span></a>
          <a class="quiet-link" href="/es/que-puedes-hacer-tu">Formas de ayudar <span aria-hidden="true">↗</span></a>
        </div>
        <div class="hero-note"><span class="hero-note-mark" aria-hidden="true">✳</span><span>Respeto por cada individuo.<br />Compromiso con el bienestar.</span></div>
      </div>
      <div class="hero-media">
        <img src="https://images.unsplash.com/photo-1670597898656-d159165d080d?auto=format&fit=crop&w=1800&q=85" alt="Primate en un entorno natural" width="1050" height="1400" fetchpriority="high" />
        <span class="image-caption">Rainfer <span aria-hidden="true">/</span> rescate · cuidado · aprendizaje</span>
        <span class="hero-image-index" aria-hidden="true">01 — 03</span>
      </div>
    </section>

    <div class="home-trust-strip" aria-label="Áreas de trabajo">
      <span>Una misión compartida</span><span>Bienestar animal</span><span>Educación ambiental</span><span>Conocimiento responsable</span>
    </div>

    <section class="intro-band home-intro">
      <div><p class="kicker">La razón de estar aquí</p><h2>El cuidado empieza por <em>comprender.</em></h2></div>
      <p>El bienestar no es un gesto aislado. Se construye con atención, entornos seguros, conocimiento y una comunidad dispuesta a aprender. Cada historia merece una mirada informada y respetuosa.</p>
    </section>

    <section class="home-pillars" aria-labelledby="pillars-title">
      <div class="section-heading home-section-heading">
        <p class="kicker">Lo que nos mueve</p>
        <h2 id="pillars-title">Del cuidado a la conciencia.</h2>
        <p>Explora las áreas que conectan la protección de los primates con una sociedad mejor informada.</p>
      </div>
      <div class="pillar-grid">
        {pillars.map((pillar) => (
          <a class="pillar-card" href={pillar.href}>
            <div class="pillar-image"><img src={pillar.image} alt={pillar.alt} loading="lazy" width="800" height="600" /><span class="pillar-number">{pillar.number}</span></div>
            <div class="pillar-content"><h3>{pillar.title}</h3><p>{pillar.text}</p><span class="pillar-link">Explorar <span aria-hidden="true">↗</span></span></div>
          </a>
        ))}
      </div>
    </section>

    <ConservationGuide locale="es" />

    {featured && <section class="feature-section home-feature">
      <div class="feature-image"><img src="https://images.unsplash.com/photo-1521737711867-e3b97375f902?auto=format&fit=crop&w=1800&q=85" alt="Personas colaborando en una misión de cuidado y conservación" loading="lazy" width="1800" height="1200" /></div>
      <div class="feature-copy"><p class="kicker">Nuestra labor</p><h2>Una labor que va más allá del rescate.</h2><p>{featured.summary} El cuidado, la divulgación y la educación forman parte de una misma conversación sobre bienestar.</p><a class="text-link" href="/es/que-hacemos">Conocer el trabajo <span aria-hidden="true">↗</span></a></div>
    </section>}

    {species && <section class="species-section home-species">
      <div class="section-heading"><p class="kicker">Conocer para cuidar</p><h2>El mundo de los primates.</h2><p>Descubre algunas de las familias de primates y acércate a sus características desde el respeto.</p></div>
      <div class="species-grid">{species.cards?.slice(0, 3).map((card, index) => <a href={card.href} class="species-card"><img src={speciesImages[index]} alt={card.title} loading="lazy" width="800" height="600" /><span>{card.title}<span class="species-arrow" aria-hidden="true">↗</span></span></a>)}</div>
      <a class="text-link species-all-link" href="/es/los-primates-2">Explorar la guía de primates <span aria-hidden="true">↗</span></a>
    </section>}

    <section class="home-visit-band">
      <div class="visit-symbol" aria-hidden="true">✳</div>
      <div><p class="kicker">Formar parte del cambio</p><h2>El cuidado también se construye en comunidad.</h2><p>Infórmate sobre las formas de apoyar la misión y consulta siempre los canales oficiales para conocer las opciones disponibles.</p></div>
      <a class="button button-light" href="/es/que-puedes-hacer-tu">Cómo puedes ayudar <span aria-hidden="true">↗</span></a>
    </section>

    <section class="home-explore">
      <div><p class="kicker">¿Buscas algo concreto?</p><h2>Continúa explorando.</h2><p>Encuentra información sobre el centro, sus programas y sus recursos.</p></div>
      <SearchPanel locale="es" />
    </section>
  </div>
</BaseLayout>
