---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchPanel from '../components/SearchPanel.astro';
import { pages } from '../content/site';
const featured = pages.find((p) => p.path === 'que-hacemos');
const species = pages.find((p) => p.path === 'los-primates-2');
---
<BaseLayout title="Rainfer — Rescate, bienestar y educación" description="Rainfer: un espacio de rescate, cuidado y aprendizaje dedicado a los primates." path="/">
  <div class="home-shell">
    <section class="home-hero">
      <div class="hero-copy"><p class="kicker">Centro de rescate y recuperación</p><h1>Un lugar seguro.<br /><em>Una vida por delante.</em></h1><p class="lede">Rainfer trabaja para que el rescate de primates se convierta en cuidado, conocimiento y futuro.</p><div class="hero-actions"><a class="button button-light" href="/es/que-hacemos">Conocer el trabajo ↗</a><a class="quiet-link" href="/es/que-puedes-hacer-tu">Cómo ayudar</a></div></div>
      <div class="hero-media"><img src="/assets/hero.jpg" alt="Primate en un entorno de cuidado, imagen de la copia pública suministrada" width="1050" height="1400" /><span class="image-caption">Rainfer · rescate y recuperación</span></div>
    </section>
    <section class="intro-band"><div><p class="kicker">Una misión concreta</p><h2>Cuidar también es <em>entender.</em></h2></div><p>El bienestar animal se construye en los detalles: un espacio seguro, una rutina atenta, un equipo preparado y una sociedad que aprende a mirar de otra manera.</p></section>
    {featured && <section class="feature-section"><div class="feature-image"><img src="/assets/sanctuary.jpg" alt="Espacio natural de Rainfer" loading="lazy" width="1800" height="1200" /></div><div class="feature-copy"><p class="kicker">{featured.eyebrow}</p><h2>{featured.title}</h2><p>{featured.summary}</p><a class="text-link" href="/es/que-hacemos">Explorar el trabajo ↗</a></div></section>}
    {species && <section class="species-section"><div class="section-heading"><p class="kicker">Conocer para cuidar</p><h2>El mundo de los primates</h2><p>Acércate a sus formas de vida, vínculos y necesidades desde una mirada respetuosa.</p></div><div class="species-grid">{species.cards?.slice(0,3).map((card) => <a href={card.href} class="species-card"><img src={card.image} alt="" loading="lazy" width="800" height="600" /><span>{card.title}</span></a>)}</div></section>}
    <section class="support-band"><div><p class="kicker">El cuidado es colectivo</p><h2>Hay muchas formas de estar cerca.</h2></div><a class="button button-dark" href="/es/que-puedes-hacer-tu">Descubrir cómo ayudar ↗</a></section>
    <SearchPanel locale="es" />
  </div>
</BaseLayout>
