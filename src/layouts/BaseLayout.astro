---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Locale } from '../content/site';
import { ui } from '../i18n/strings';
interface Props { locale?: Locale; title: string; description: string; image?: string; path?: string; noindex?: boolean; }
const { locale = 'es', title, description, image = '/assets/hero.jpg', path = '', noindex = false } = Astro.props;
const origin = (import.meta.env.PUBLIC_SITE_URL || '').replace(/\/$/, '');
const canonical = origin && path ? `${origin}${path.startsWith('/') ? path : `/${path}`}` : undefined;
const absoluteImage = /^https?:\/\//i.test(image) ? image : origin ? `${origin}${image.startsWith('/') ? image : `/${image}`}` : image;
const copy = ui[locale];
const structuredData = { '@context': 'https://schema.org', '@type': 'WebPage', name: title, description, inLanguage: locale, ...(canonical ? { url: canonical } : {}), isPartOf: { '@type': 'WebSite', name: 'Rainfer — informational reconstruction', ...(origin ? { url: origin } : {}) } };
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#173f35" />
    <meta name="color-scheme" content="light" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" as="image" href={image} fetchpriority="high" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_GB'} />
    <meta property="og:site_name" content="Rainfer" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:alt" content={locale === 'es' ? 'Rainfer: rescate, cuidado y educación de primates' : 'Rainfer: primate rescue, care and education'} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main">{copy.skip}</a>
    <Header locale={locale} />
    <main id="main"><slot /></main>
    <Footer locale={locale} />
    <script is:inline>
      const menu = document.querySelector('[data-menu]');
      const button = document.querySelector('[data-menu-button]');
      const closeMenu = () => {
        menu?.removeAttribute('data-open');
        button?.setAttribute('aria-expanded', 'false');
        if (button instanceof HTMLButtonElement) button.textContent = button.dataset.openLabel || button.textContent;
      };
      button?.addEventListener('click', () => {
        const open = menu?.toggleAttribute('data-open') || false;
        button.setAttribute('aria-expanded', String(open));
        if (button instanceof HTMLButtonElement) button.textContent = open ? (button.dataset.closeLabel || button.textContent) : (button.dataset.openLabel || button.textContent);
      });
      menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeMenu(); });
      document.querySelectorAll('[data-accordion]').forEach((item) => item.addEventListener('click', () => item.toggleAttribute('open')));
      document.querySelectorAll('[data-language-picker]').forEach((picker) => {
        picker.addEventListener('change', (event) => {
          const select = event.currentTarget;
          if (!(select instanceof HTMLSelectElement)) return;
          const translated = document.querySelector('.goog-te-combo');
          if (translated instanceof HTMLSelectElement) {
            translated.value = select.value;
            translated.dispatchEvent(new Event('change'));
          }
        });
      });
      Reflect.set(window, 'googleTranslateElementInit', function () {
        const translate = Reflect.get(window, 'google')?.translate;
        if (translate?.TranslateElement) {
          new translate.TranslateElement({
            pageLanguage: document.documentElement.lang || 'es',
            includedLanguages: 'es,en,zh-CN,hi,ar,fr,pt,ru,de',
            autoDisplay: false
          }, 'google_translate_element');
        }
      });
    </script>
    <div id="google_translate_element" class="google-translate-host" aria-hidden="true"></div>
    <script src="https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit" defer></script>
  </body>
</html>
